# Optional AI providers / fallback order
AI_PROVIDER_ORDER=gemini,groq,openai,deepseek
GEMINI_MODEL=gemini-2.0-flash
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=
