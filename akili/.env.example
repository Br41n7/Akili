# ── Supabase (same project as PastQ — shared database) ─────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── AI Providers ────────────────────────────────────────────────
GEMINI_API_KEY=          # aistudio.google.com — vision + reasoning tasks
GROQ_API_KEY=            # console.groq.com — course builder + content (free 14k/day)

# ── Cross-app ───────────────────────────────────────────────────
